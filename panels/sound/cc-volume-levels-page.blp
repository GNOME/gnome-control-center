using Gtk 4.0;
using Adw 1;

template $CcVolumeLevelsPage: Adw.NavigationPage {
  title: _("Volume Levels");

  child: Adw.BreakpointBin {
    width-request: bind template.root as <Window>.width-request;
    height-request: bind template.root as <Window>.height-request;

    Adw.Breakpoint {
      condition ("max-width: 500sp")

      setters {
        template.narrow: true;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Stack stack {
        StackPage {
          name: "no-streams-found-page";

          child: Adw.StatusPage {
            icon-name: "org.gnome.Settings-sound-symbolic";
            title: _("No Sound Playing");
          };
        }

        StackPage {
          name: "streams-page";

          child: Adw.PreferencesPage {
            Adw.PreferencesGroup output_group {
              visible: false;
              title: _("Outputs");
            }

            Adw.PreferencesGroup input_group {
              visible: false;
              title: _("Inputs");
            }
          };
        }
      };
    };
  };
}

SizeGroup label_size_group {
  mode: horizontal;
}
