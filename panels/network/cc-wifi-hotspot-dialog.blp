using Gtk 4.0;
using Adw 1;

template $CcWifiHotspotDialog: Adw.Dialog {
  title: _("Turn On Wi-Fi Hotspot?");
  content-width: 460;
  content-height: 460;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        use-underline: true;
        label: _("_Cancel");
        clicked => $adw_dialog_close(template);
      }

      [end]
      Button ok_button {
        use-underline: true;
        label: _("_Turn On");
        receives-default: true;
        clicked => $on_turn_on_button_clicked_cb(template);

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage wifi_hotspot_page {
      description: _("Wi-Fi hotspot allows others to share your internet connection, by creating a Wi-Fi network that they can connect to. To do this, you must have an internet connection through a source other than Wi-Fi.");

      Adw.PreferencesGroup {
        title: _("Hotspot Details");

        Adw.EntryRow name_entry {
          title: _("Network Name");
          max-length: 64;
          changed => $hotspot_entry_changed_cb(template);

          accessibility {
            error-message: name_error_label;
            required: true;
          }
        }

        Adw.PasswordEntryRow password_entry {
          title: _("Password");
          max-length: 64;
          changed => $hotspot_entry_changed_cb(template);

          accessibility {
            error-message: password_error_label;
          }

          [suffix]
          Button {
            valign: center;
            icon-name: "view-refresh-symbolic";
            tooltip-text: _("Generate Random Password");
            clicked => $generate_password_clicked_cb(template);

            styles [
              "flat",
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 6;
          margin-top: 12;

          Label name_error_label {
            halign: start;
            wrap: true;

            styles [
              "dim-label",
              "caption",
            ]
          }

          Label password_error_label {
            halign: start;
            wrap: true;

            styles [
              "dim-label",
              "caption",
            ]
          }
        }
      }
    };
  };
}
