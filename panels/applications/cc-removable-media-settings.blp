using Gtk 4.0;
using Adw 1;

template $CcRemovableMediaSettings: Adw.PreferencesGroup {
  $CcRemovableMediaRow {
    title: _("CD _Audio");
    use-underline: true;
    content-type: "x-content/audio-cdda";
    heading: _("Select an app for audio CDs");
  }

  $CcRemovableMediaRow {
    title: _("_DVD Video");
    use-underline: true;
    content-type: "x-content/video-dvd";
    heading: _("Select an app for video DVDs");
  }

  $CcRemovableMediaRow {
    title: _("Music Pla_yer");
    use-underline: true;
    content-type: "x-content/audio-player";
    heading: _("Select an app to run when a music player is connected");
  }

  $CcRemovableMediaRow {
    title: _("P_hotos");
    use-underline: true;
    content-type: "x-content/image-dcf";
    heading: _("Select an app to run when a camera is connected");
  }

  $CcRemovableMediaRow {
    title: _("Sof_tware");
    use-underline: true;
    content-type: "x-content/unix-software";
    heading: _("Select an app for software CDs");
  }
}
