#: panels/system/users/pw-utils.c:101
msgctxt "Password hint"
msgid "The new password needs to be different from the old one"
msgstr "새 비밀번호는 과거 비밀번호와 달라야 합니다"

#: panels/system/users/pw-utils.c:103
msgctxt "Password hint"
msgid "Try changing some letters and numbers"
msgstr "문자와 숫자를 바꿔 보십시오"

#: panels/system/users/pw-utils.c:105 panels/system/users/pw-utils.c:113
msgctxt "Password hint"
msgid "Try changing the password a bit more"
msgstr "비밀번호를 약간 바꿔 보십시오"

#: panels/system/users/pw-utils.c:107
msgctxt "Password hint"
msgid "A password without your user name would be stronger"
msgstr "사용자 이름이 들어 있지 않은 비밀번호가 더 강력합니다"

#: panels/system/users/pw-utils.c:109
msgctxt "Password hint"
msgid "Try to avoid using your name in the password"
msgstr "비밀번호에 이름을 사용하지 말아 보십시오"

#: panels/system/users/pw-utils.c:111
msgctxt "Password hint"
msgid "Try to avoid some of the words included in the password"
msgstr "비밀번호에 포함된 단어를 사용하지 말아 보십시오"

#: panels/system/users/pw-utils.c:115
msgctxt "Password hint"
msgid "Avoid common words"
msgstr "일반적인 단어를 피해 보십시오"

#: panels/system/users/pw-utils.c:117
msgctxt "Password hint"
msgid "Try to avoid reordering existing words"
msgstr "단어를 조합하지 말아 보십시오"

#: panels/system/users/pw-utils.c:119
msgctxt "Password hint"
msgid "Try to use more numbers"
msgstr "숫자를 더 사용해 보십시오"

#: panels/system/users/pw-utils.c:121
msgctxt "Password hint"
msgid "Try to use more uppercase letters"
msgstr "대문자를 더 사용해 보십시오"

#: panels/system/users/pw-utils.c:123
msgctxt "Password hint"
msgid "Try to use more lowercase letters"
msgstr "소문자를 더 사용해 보십시오"

#: panels/system/users/pw-utils.c:125
msgctxt "Password hint"
msgid "Try to use more special characters, like punctuation"
msgstr "문장 기호 등 특수 문자를 더 사용해 보십시오"

