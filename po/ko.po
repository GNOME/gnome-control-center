#: panels/color/cc-color-calibrate.blp:28
msgid "_Start"
msgstr "시작(_S)"

#. Translators: This resumes the calibration process
#: panels/color/cc-color-calibrate.blp:34
msgid "_Resume"
msgstr "다시 시작(_R)"

