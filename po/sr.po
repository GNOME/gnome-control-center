#: panels/color/cc-color-calibrate.blp:8
msgid "Display Calibration"
msgstr "Калибрација екрана"

#. Translators: This starts the calibration process
#: panels/color/cc-color-calibrate.blp:28
msgid "_Start"
msgstr "_Покрени"

#. Translators: This resumes the calibration process
#: panels/color/cc-color-calibrate.blp:34
msgid "_Resume"
msgstr "_Настави"

#. Translators: This button returns the user back to the color control panel
#: panels/color/cc-color-calibrate.blp:40 panels/keyboard/cc-keyboard-shortcut-editor.blp:34 panels/system/users/cc-fingerprint-dialog.blp:179
msgid "_Done"
msgstr "_Готово"

#. TRANSLATORS: The user has to be careful not to knock the
#. * display off the screen (although we do cope if this is
#. * detected early enough)
#: panels/color/cc-color-calibrate.blp:61 panels/color/cc-color-calibrate.c:459
msgid "Do not disturb the calibration device while in progress"
msgstr "Не ометајте уређај за калибрацију док је рад у току"

#. TRANSLATORS: The user has to attach the sensor to the screen
#: panels/color/cc-color-calibrate.c:299
msgid "Place your calibration device over the square and press “Start”"
msgstr "Поставите уређај за калибрацију преко квадрата и притисните „Покрени“"

#. TRANSLATORS: Some calibration devices need the user to move a
#. * dial or switch manually. We also show a picture showing them
#. * what to do...
#: panels/color/cc-color-calibrate.c:305
msgid "Move your calibration device to the calibrate position and press “Continue”"
msgstr "Померите уређај за калибрацију на положај за калибрацију и притисните „Настави“"

#. TRANSLATORS: Some calibration devices need the user to move a
#. * dial or switch manually. We also show a picture showing them
#. * what to do...
#: panels/color/cc-color-calibrate.c:311
msgid "Move your calibration device to the surface position and press “Continue”"
msgstr "Померите уређај за калибрацију на положај површине и притисните „Настави“"

#. TRANSLATORS: on some hardware e.g. Lenovo W700 the sensor
#. * is built into the palmrest and we need to fullscreen the
#. * sample widget and shut the lid.
#: panels/color/cc-color-calibrate.c:317
msgid "Shut the laptop lid"
msgstr "Заклопите поклопац преносног рачунара"

#. TRANSLATORS: We suck, the calibration failed and we have no
#. * good idea why or any suggestions
#: panels/color/cc-color-calibrate.c:344
msgid "An internal error occurred that could not be recovered."
msgstr "Дошло је до унутрашње грешке која се не може исправити."

#. TRANSLATORS: Some required-at-runtime tools were not
#. * installed, which should only affect insane distros
#: panels/color/cc-color-calibrate.c:349
msgid "Tools required for calibration are not installed."
msgstr "Алати потребни за калибрацију нису инсталирани."

#. TRANSLATORS: The profile failed for some reason
#: panels/color/cc-color-calibrate.c:355
msgid "The profile could not be generated."
msgstr "Не могу да направим профил."

#. TRANSLATORS: The user specified a whitepoint that was
#. * unobtainable with the hardware they've got -- see
#. * https://en.wikipedia.org/wiki/White_point for details
#: panels/color/cc-color-calibrate.c:361
msgid "The target whitepoint was not obtainable."
msgstr "Не могу да постигнем циљну белу тачку."

#. TRANSLATORS: the display calibration process is finished
#: panels/color/cc-color-calibrate.c:393
msgid "Complete!"
msgstr "Завршено!"

#. TRANSLATORS: the display calibration failed, and we also show
#. * the translated (or untranslated) error string after this
#: panels/color/cc-color-calibrate.c:398
msgid "Calibration failed!"
msgstr "Калибрација није успела!"

#. TRANSLATORS: The user can now remove the sensor from the screen
#: panels/color/cc-color-calibrate.c:405
msgid "You can remove the calibration device."
msgstr "Можете уклонити уређај за калибрацију."

#. TRANSLATORS: This refers to the embedded display on e.g. a smartphone, a laptop, an all-in-one desktop…
#: panels/color/cc-color-common.c:39
msgid "Built-In Screen"
msgstr "Уграђени екран"

#. TRANSLATORS: This refers to the embedded webcam on e.g. a smartphone, a laptop, an all-in-one desktop…
